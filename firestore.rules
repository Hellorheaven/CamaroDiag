rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the signed-in license owner may read status; clients never write.
    match /licenses/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    // Billing ledgers, Stripe IDs, disputes and receipts are admin-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
