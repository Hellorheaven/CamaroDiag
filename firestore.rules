rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CamaroDiag stores only license records under licenses/{firebaseUid}.
    // Identity, account status and roles are handled by Firebase Authentication.
    // Cloud Functions use the Admin SDK; clients cannot access Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
