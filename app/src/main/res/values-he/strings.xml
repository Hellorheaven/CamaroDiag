    <string name="module_note_ecm">דוגמה לבקשה/תגובה פונקציונלית של OBD-II ‏(7DF/7E8 ב-CAN של 11 סיביות). אין בכך הגדרה של כתובת אבחון פיזית מורחבת של GM או אישור לשירותים מורחבים.</string>
    <string name="module_note_ecm_obd_detected">נצפתה תגובת 7E8 לבקשת OBD פונקציונלית תקנית 0100. הדבר מאשר גישת OBD תקנית למערכת ההנעה בלבד ואינו מאשר שירותי GM מורחבים.</string>
    <string name="module_note_ecm_obd_missing">לא נצפתה תגובת OBD תקנית 7E8. יש להשאיר את ה-ECM לא מאומת עד שסריקה פונקציונלית אמיתית תאשר אותו.</string>
    <string name="module_note_tcm_gen5">יש לזהות ברכב את הנוכחות, הכתובת והנתונים הנתמכים.</string>
    <string name="module_note_tcm_gen6">יש לזהות ברכב את כתובת המודול והשירותים הנתמכים; אין להסיק אותם מטופולוגיית דור 5.</string>
    <string name="module_note_bcm_gen5">עלון GM ‏07-08-49-020I מזהה את ה-BCM כמודול אחסון מד המרחק ב-Camaro ‏2010–2015. אין הנחה לגבי כתובת האבחון המדויקת או DID לקריאה.</string>
    <string name="module_note_bcm_gen6_to2018">עלון GM ‏07-08-49-020M מציין את ה-BCM כמודול אחסון מד המרחק של Camaro עד 2018. עדיין נדרש אימות של כתובת האבחון ו-DID הקריאה לפי ה-VIN.</string>
    <string name="module_note_bcm_2019">בדגמי 2019–2024 יש לאמת את ארכיטקטורת אחסון מד המרחק ואת מזהי האבחון עבור VIN זה לפני הקריאה.</string>
    <string name="module_note_ipc_gen5">מידע השירות של Camaro משנת 2012 מתאר את ה-IPC כאחסון משני של מד המרחק. יש לאמת את נתוני הקריאה והכתובת המדויקים.</string>
    <string name="module_note_ipc_gen6">אחסון משני של מד המרחק מתואר במידע השירות של Camaro משנת 2012; יש לאמת את נתוני המודול המדויקים ואת הקשר ל-VIN לפני השוואה.</string>
    <string name="module_note_ebcm_gen5">אין הנחה לגבי כתובות GM מורחבות; יש לבצע סריקה מאומתת של היחידה.</string>
    <string name="module_note_ebcm_gen6">סריקת מודול מורחבת עדיין לא אומתה עבור VIN זה.</string>
